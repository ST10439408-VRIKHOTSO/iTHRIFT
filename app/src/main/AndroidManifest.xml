<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".IThriftApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.IThrift"
        android:usesCleartextTraffic="${allowCleartext}">
        <!--
          allowBackup is off so the saved sign-in never leaves the phone in a
          cloud or adb backup.

          usesCleartextTraffic comes from the build type (app/build.gradle.kts):
          a debug build may talk to a development server over plain http://
          (http://10.0.2.2:3000 or http://<your-PC-LAN-IP>:3000), while a
          release build refuses http:// and only talks to the hosted server
          over https://.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Where the website's Google sign-in page sends the customer back to. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ithrift" android:host="signed-in" />
                <data android:scheme="ithrift" android:host="payment" />
            </intent-filter>
        </activity>
    </application>

</manifest>
