<?xml version="1.0" encoding="utf-8"?>
<!--
  The in-app help system. Task-based rather than feature-based: the headings
  are the things a customer is actually trying to do ("Track an order"), not
  the names of our screens, because someone who is stuck does not know what
  we called the screen. The same content is in docs/user-guide.md, which is
  the written user documentation for the project.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="@string/help_intro"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!--
          The topics are laid out one after another rather than in a
          RecyclerView: there are eight of them, they never change at
          runtime, and a list adapter for eight fixed items is more code to
          read and more to go wrong than the items themselves.
        -->
        <LinearLayout
            android:id="@+id/container_topics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/secondary_bg"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/TextAppearance.IThrift.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_still_stuck" />

            <TextView
                android:id="@+id/text_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/help_support_body"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/text_diagnostics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
