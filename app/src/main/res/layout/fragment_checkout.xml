<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checkout"
            android:textColor="@color/ink"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Payment method"
                android:textStyle="bold"
                android:textColor="@color/ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="Payments are simulated for this prototype — no money changes hands."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/radio_group_payment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/radio_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Credit / debit card"
                    android:checked="true"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/radio_payfast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PayFast"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/radio_eft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EFT (pending until confirmed)"
                    android:padding="8dp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/text_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textStyle="bold"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_place_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/action_place_order"
                android:textAllCaps="false"
                android:backgroundTint="@color/accent"
                app:cornerRadius="24dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
